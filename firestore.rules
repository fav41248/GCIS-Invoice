rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for schema validation
    function hasOnlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }
    
    function hasAllKeys(keys) {
      return request.resource.data.keys().hasAll(keys);
    }

    // Since the app uses custom PIN-based auth, request.auth is null.
    // We harden the database by strictly validating the schema of incoming writes.
    // This prevents bad actors from dumping arbitrary data or modifying schemas.

    match /users/{userId} {
      allow read: if true;
      allow create, update: if hasAllKeys(['username', 'role', 'name', 'pin', 'createdAt']) &&
                   request.resource.data.role in ['admin', 'sales'] &&
                   request.resource.data.username is string &&
                   request.resource.data.pin is string;
      allow delete: if true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string;
      allow delete: if true;
    }

    match /invoices/{invoiceId} {
      allow read: if true;
      allow create, update: if request.resource.data.invoiceNumber is string &&
                   request.resource.data.clientName is string &&
                   request.resource.data.grandTotal is number;
      allow delete: if true;
    }
    
    match /clients/{clientId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string &&
                   request.resource.data.email is string;
      allow delete: if true;
    }
    
    match /products/{itemId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string &&
                   request.resource.data.price is number;
      allow delete: if true;
    }
    
    match /knowledge/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.title is string &&
                   request.resource.data.content is string;
      allow delete: if true;
    }
    
    // Reject anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
